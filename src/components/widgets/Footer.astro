---
import { Icon } from 'astro-icon/components';
import { SITE } from '~/utils/config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  external?: boolean;
  className?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-border-default not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-default">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl" href={getHomePermalink()}>{SITE?.name}</a>
        </div>
        <div class="text-sm text-muted">
          {
            secondaryLinks.map(({ text, href }) => (
              <a
                class="text-muted hover:text-gray-700 dark:text-muted hover:underline transition duration-150 ease-in-out mr-2"
                href={href}
                set:html={text}
              />
            ))
          }
        </div>
        <p class="text-sm text-muted mb-4">
          Has MonitoRSS helped you or your community? Show your support by just adding a star on Github!
        </p>
        <!-- <a href="https://www.patreon.com/monitorss" target="_blank" rel="noopener noreferrer" class="block mb-2">
          <img src="https://c5.patreon.com/external/logo/become_a_patron_button.png" aria-label="Support MonitoRSS by becoming a patron" />
        </a> -->
        <a class="github-button" href="https://github.com/synzen/monitorss" data-icon="octicon-star" data-size="large" data-show-count="true" aria-label="Star synzen/monitorss on GitHub">Star</a>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="dark:text-default font-medium mb-2">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel, external, className }) => (
                  <li class="mb-2">
                    <a
                      class={`text-muted hover:text-gray-700 hover:underline dark:text-muted transition duration-150 ease-in-out${className ? ` ${className}` : ''}`}
                      href={href}
                      aria-label={ariaLabel}
                      target={`${external ? '_blank' : ''}`}
                    >
                      <Fragment set:html={text} />
                      {external && <Icon name="tabler:external-link" class="w-3 h-3 inline-block ml-1 align-baseline" />}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-muted dark:text-muted hover:bg-gray-100 dark:hover:bg-emphasized focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-emphasized rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm mr-4 dark:text-muted">
        <Fragment set:html={footNote} />
        <span data-relayvale hidden>© 2026 Relayvale LLC. MonitoRSS is operated by Relayvale LLC.</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var isDevHost = /^(localhost|127\.0\.0\.1)$/.test(window.location.hostname);
    var isPreview = params.has('relayvale');
    var cutover = isDevHost || isPreview || new Date() >= new Date('2026-10-19T00:00:00Z');
    function setHidden(el, hide) {
      var li = el.closest ? el.closest('li') : null;
      (li || el).style.display = hide ? 'none' : '';
    }
    document.querySelectorAll('[data-relayvale]').forEach(function (el) {
      el.hidden = !cutover;
    });
    if (cutover) {
      document.querySelectorAll('.monitorss-only').forEach(function (el) {
        setHidden(el, true);
      });
      document.querySelectorAll('.relayvale-only').forEach(function (el) {
        el.classList.remove('hidden');
        setHidden(el, false);
      });
    }
  })();
</script>

<script async defer src="https://buttons.github.io/buttons.js"></script>