---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Privacy Policy',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-4xl">
    <div class="mb-6 rounded-lg border p-4 text-sm">
      <p><strong>Effective October 19, 2026.</strong> This version is in effect.</p>
      <p class="mt-2">
        The previous version, in effect through October 18, 2026, is available here:
        <a class="underline" href="/legal/privacy-2023-09-29">Privacy Policy</a>.
      </p>
    </div>
    <div name="termly-embed" data-id="32cb2301-2d30-4599-921f-55b376f623e5"></div>
    <script src="https://app.termly.io/embed-policy.min.js" async></script>
  </section>
</Layout>
