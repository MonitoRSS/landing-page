---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Terms and Conditions',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-4xl">
    <div class="mb-6 rounded-lg border p-4 text-sm">
      <p><strong>Effective on or after October 19, 2026.</strong> This version is not yet in effect.</p>
      <p class="mt-2">
        The current version in effect through October 18, 2026 is available here:
        <a class="underline" href="/terms">Terms and Conditions</a>.
      </p>
    </div>
    <div name="termly-embed" data-id="ae38c990-41a4-4901-a550-274f3175437e"></div>
    <script src="https://app.termly.io/embed-policy.min.js" async></script>
  </section>
</Layout>
