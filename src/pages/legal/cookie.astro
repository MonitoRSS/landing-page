---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Cookie Policy',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-4xl">
    <div class="mb-6 rounded-lg border p-4 text-sm">
      <p><strong>Effective on or after September 12, 2026.</strong></p>
    </div>
    <div name="termly-embed" data-id="219882c9-bee2-488b-8c08-78184aab7c0b"></div>
    <script src="https://app.termly.io/embed-policy.min.js" async></script>
  </section>
</Layout>
